# Python virtual environment
venv/
__pycache__/
*.pyc

# Node modules (once frontend phase starts) — regenerated via npm install
node_modules/

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
*.swp

# Training checkpoints — only the FINAL model that powers the demo should
# be tracked, not every intermediate save. Ignore the folder by default...
training/checkpoints/*
# ...then explicitly un-ignore the specific final checkpoint file(s) once
# training completes, e.g.:
# !training/checkpoints/final_model.zip