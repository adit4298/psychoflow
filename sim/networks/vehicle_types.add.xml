           length="4.5" width="1.8" maxSpeed="16.7"
           accel="2.6" decel="4.5" sigma="0.5" minGap="2.0" />

    <vType id="truck" vClass="truck" guiShape="truck"
           length="7.5" width="2.4" maxSpeed="12.5"
           accel="1.3" decel="3.5" sigma="0.5" minGap="2.5" />

    <vType id="ambulance" vClass="emergency" guiShape="emergency"
           length="5.5" width="2.0" maxSpeed="19.4"
