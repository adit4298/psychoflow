           length="1.8" width="0.65" maxSpeed="7.0"
           accel="1.2" decel="3.0" sigma="0.5" minGap="1.0" />

    <vType id="auto" vClass="passenger" guiShape="passenger"
           length="3.2" width="1.4" maxSpeed="11.0"
           accel="1.8" decel="4.0" sigma="0.6" minGap="1.5" />

