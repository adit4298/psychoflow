<?xml version="1.0" encoding="UTF-8"?>
<!--
  sumo-gui view settings for the MIXED-TRAFFIC DEMO WATCH (§10/§11 of CLAUDE.md).

  Purpose: make the human sign-off watch reproducible, so the reviewer is not
  hand-setting colour-by-type every time and is not left staring at one lane
  segment mistaking it for the whole corridor.

  What this sets, and why each one matters for THIS watch:

  * colorScheme "by type"  — the whole point. Under the demo driving model the
    vType ids are the CONCRETE TIER members (bike.cautious / bike.normal /
    bike.aggressive, auto.*, car.*, plus untiered truck and ambulance), so
    "by type" gives each TIER its own colour. That is what makes driver
    heterogeneity visible rather than merely measured — you should be able to
    see one bike filtering hard to the stop line while another queues.

  * vehicle_exaggeration 3.0 — the corridor is 900m x 300m. Zoomed out far
    enough to see J1, J2 and J3 at once, a 1.8m bike is sub-pixel. Scaling
    vehicles up is what makes the wide view watchable at all. It exaggerates
    SIZE only; positions, lateral offsets and dynamics are untouched, so the
    lane-straddling and queue-front filtering you are judging are real.
    NOTE: at 3.0 vehicles LOOK like they overlap when they do not — do not
    read apparent overlap as a collision. Drop this to 1.0 and zoom in if you
    want to judge physical clearance.

  * showBlinker — lane-change intent is visible, which is what distinguishes
    a deliberate overtake from a drift.

  * junction/lane detail left on so the sublane straddling is legible.

  This file is DEMO-ONLY scaffolding, like vehicle_types_demo.add.xml itself.
  Nothing in training or evaluation reads it (nothing headless reads a GUI
  settings file at all).
-->
<viewsettings>

    <!-- Playback speed. This is a sumo-gui WALL-CLOCK sleep between rendered
         steps and has ZERO effect on the simulation (CLAUDE.md §8, ITEM 3a).
         250ms/step makes a ~15s green last ~3.7 wall-seconds, which is roughly
         real-time-feeling. Raise it to slow the picture down; it changes
         nothing measurable. -->
    <delay value="250"/>

    <scheme name="psychoflow demo (colour by type)">

        <opengl antialiase="1" dither="0"/>
        <background backgroundColor="255,255,255"
                    showGrid="0" gridXSize="100.00" gridYSize="100.00"/>

        <edges laneEdgeMode="0" scaleMode="0" laneShowBorders="1"
               showBikeMarkings="1" showLinkDecals="1" showLinkRules="1"
               showRails="1" hideConnectors="0" widthExaggeration="1"
               minSize="0" showDirection="1" showSublanes="1"
               spreadSuperposed="0" edgeParam="EDGE_KEY" laneParam="LANE_KEY"
               vehicleParam="PARAM_NUMERICAL" vehicleScaleParam="PARAM_NUMERICAL"
               edgeData="speed">
            <colorScheme name="uniform">
                <entry color="0,0,0" name="road"/>
                <entry color="140,140,140" name="Sidewalk"/>
                <entry color="15,15,150" name="Waterway"/>
                <entry color="120,120,120" name="no passenger"/>
            </colorScheme>
            <scalingScheme name="default"/>
        </edges>

        <!-- THE LOAD-BEARING BLOCK FOR THIS WATCH. -->
        <vehicles vehicleMode="0"
                  vehicleQuality="2"
                  vehicle_minSize="1.00"
                  vehicle_exaggeration="3.00"
                  showBlinker="1"
                  drawLaneChangePreference="0"
                  drawMinGap="0"
                  showBTRange="0"
                  showRouteIndex="0"
                  scaleLength="1"
                  drawReversed="0"
                  showParkingInfo="0">
            <colorScheme name="by type"/>
            <scalingScheme name="uniform"/>
        </vehicles>

        <junctions junctionMode="0" drawShape="1" drawCrossingsAndWalkingareas="1"
                   junction_minSize="1.00" junction_exaggeration="1"
                   showLane2Lane="0" showJunctionIndex="1" showTLSIndex="0"
                   showInternalJunctions="0"/>

        <additionals addMode="0" add_minSize="1.00" add_exaggeration="1"/>
        <pois poiTextColor="0,0,127" poiTextSize="50"/>
        <polys polyTextColor="0,0,127" polyTextSize="50"/>

        <legend showSizeLegend="1" showColorLegend="0" showVehicleColorLegend="1"/>

    </scheme>

</viewsettings>
