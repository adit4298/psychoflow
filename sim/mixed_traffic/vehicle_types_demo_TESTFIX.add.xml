               jmIgnoreFoeProb="0.0" jmTimegapMinor="1.2" jmStoplineGap="0.6" />

        <!-- STEP 1's signed-off auto table, kept as the ceiling. One change:
             lcTimeToImpatience 8.0 -> 20.0. -->
        <vType id="auto.aggressive" probability="0.25"
               vClass="passenger" guiShape="passenger"
               length="3.2" width="1.4" minGap="1.2"
               maxSpeed="9.5" accel="2.0" decel="4.0"
               speedFactor="normc(1.00,0.09,0.85,1.18)"
