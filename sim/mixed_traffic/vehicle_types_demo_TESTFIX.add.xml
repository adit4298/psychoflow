           minGapLat="0.80" lcPushy="0.05" lcAssertive="0.8"
           lcSpeedGain="0.5" lcImpatience="0.0"
           lcKeepRight="1.0" lcSublane="1.0"
           maxSpeedLat="0.9" lcAccelLat="1.2"
           lcMaxSpeedLatStanding="0.0" lcMaxDistLatStanding="0.5"
           latAlignment="center"
           impatience="0.0"
           jmDriveAfterRedTime="-1" jmDriveAfterYellowTime="0.0"
           jmIgnoreFoeProb="0.0" jmTimegapMinor="2.0" jmStoplineGap="1.0" />

    <!-- ==================================================================
         AMBULANCE - single type, UNCHANGED from STEP 1. The deliberate
         contrast: the most PREDICTABLE vehicle on the corridor. Lowest
         sigma, zero pushiness, never runs a red, never ignores a foe. It
         does not need to: §10 opens the road ahead of it. maxSpeed sits
         above the 50 km/h road limit on purpose - an emergency vehicle
         exceeding the posted limit on a CLEARED corridor is correct, and
         it is a visible beat.

         Deliberately NOT tiered: §10's emergency detection and §9.4's
         emergency term both key on type_composition["ambulance"], and a
         single type keeps that path identical to the default file.
         ================================================================== -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency"
           length="5.5" width="2.0" minGap="2.0"
           maxSpeed="15.0" accel="3.0" decel="5.0"
