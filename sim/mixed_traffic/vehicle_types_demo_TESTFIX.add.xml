    <!-- ==================================================================
         CAR - 90 / 10, no cautious tier. "Cars do it too, just less
         often" (research §1.1/§1.5): the aggressive minority is real but
         small, and its jm* allowance is much smaller than bike's or
         auto's aggressive tier.

         car.normal is DELIBERATELY CALMER than STEP 1's single car type.
         Measured (research §3.2): car completed 674 passes against bike's
         487 - cars out-overtaking two-wheelers, which inverts the ordering
         the literature implies. lcSpeedGain 1.5 -> 1.1, lcAssertive
         1.2 -> 1.0, lcPushy 0.25 -> 0.15 is the correction.

         Two cars (1.8 + 1.8) cannot share a 3.2m lane, so a car can
         reposition and overtake a two-wheeler but cannot filter two-abreast
         past another car. That geometric limit is doing real work here.
         ================================================================== -->
    <vTypeDistribution id="car">

        <vType id="car.normal" probability="0.90"
               vClass="passenger" guiShape="passenger"
               length="4.5" width="1.8" minGap="2.0"
               maxSpeed="12.5" accel="2.6" decel="4.5"
               speedFactor="normc(1.00,0.08,0.85,1.15)"
               sigma="0.45" tau="1.2" startupDelay="0.4"
               laneChangeModel="SL2015"
               minGapLat="0.55" lcPushy="0.15" lcAssertive="1.0"
               lcSpeedGain="1.1" lcImpatience="0.10" lcTimeToImpatience="60.0"
               lcKeepRight="0.5" lcSublane="1.0"
               maxSpeedLat="0.9" lcAccelLat="1.0"
               lcMaxSpeedLatStanding="0.1" lcMaxDistLatStanding="0.8"
               latAlignment="center"
               impatience="0.3"
               jmDriveAfterRedTime="-1" jmDriveAfterYellowTime="0.0"
               jmIgnoreFoeProb="0.0" jmTimegapMinor="1.5" jmStoplineGap="1.0" />

        <vType id="car.aggressive" probability="0.10"
               vClass="passenger" guiShape="passenger"
               length="4.5" width="1.8" minGap="1.7"
               maxSpeed="13.0" accel="2.8" decel="4.5"
               speedFactor="normc(1.04,0.08,0.88,1.18)"
               sigma="0.55" tau="1.05" startupDelay="0.2"
               laneChangeModel="SL2015"
               minGapLat="0.45" lcPushy="0.35" lcAssertive="1.5"
               lcSpeedGain="2.0" lcImpatience="0.45" lcTimeToImpatience="25.0"
               lcKeepRight="0.2" lcSublane="0.7"
               maxSpeedLat="1.1" lcAccelLat="1.2"
               lcMaxSpeedLatStanding="0.2" lcMaxDistLatStanding="1.0"
               latAlignment="arbitrary"
               impatience="0.6"
               jmDriveAfterRedTime="0.3" jmDriveAfterYellowTime="1.5"
               jmDriveRedSpeed="4.0" jmIgnoreFoeProb="0.02" jmIgnoreFoeSpeed="2.0"
               jmTimegapMinor="1.3" jmStoplineGap="0.8" />

    </vTypeDistribution>

    <!-- ==================================================================
         TRUCK - single type, UNCHANGED from STEP 1. Conservative;
         minGapLat ABOVE SUMO's own 0.6 default, i.e. genuinely cautious
         rather than merely un-aggressive. Never runs a red.
         ================================================================== -->
    <vType id="truck" vClass="truck" guiShape="truck"
           length="7.5" width="2.4" minGap="2.5"
           maxSpeed="10.0" accel="1.3" decel="3.5"
